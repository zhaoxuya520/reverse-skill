{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://reverse-skill.local/schemas/scope.schema.json",
  "title": "reverse-skill Scope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scopeId", "status", "approvalId", "issuedAt", "expiresAt", "targets", "allowedActions"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1" },
    "scopeId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "status": { "type": "string", "enum": ["draft", "granted", "denied", "expired"] },
    "approvalId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "targets": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "scheme", "host", "port", "pathPrefixes"],
            "properties": {
              "type": { "const": "network" },
              "scheme": { "type": "string", "enum": ["http", "https"] },
              "host": { "type": "string", "pattern": "^[^*\\s/]+$" },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "pathPrefixes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^/" } }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "path"],
            "properties": {
              "type": { "const": "file" },
              "path": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "allowedActions": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]+$" } },
    "notes": { "type": "string", "maxLength": 4096 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "granted" } } },
      "then": { "properties": { "targets": { "minItems": 1 }, "allowedActions": { "minItems": 1 } } }
    }
  ]
}
